# Application
APP_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_secret_password
DB_NAME=taskmanager_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=15m

# Security & JWT Tokens
# Generate a strong key in terminal: openssl rand -base64 32
JWT_SECRET=super_secret_jwt_signing_key_change_me_in_prod
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=168h

# Standard SMTP Email Settings (Works with Mailtrap in dev, AWS SES / SendGrid in prod)
# Dev (Mailtrap Sandbox): host=sandbox.smtp.mailtrap.io, port=2525
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
FROM_EMAIL=no-reply@taskmanager.local
